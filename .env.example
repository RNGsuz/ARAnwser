OPENAI_API_KEY=sk-...
OPENAI_VISION_MODEL=gpt-5.6-luna
# Optional: separate models for frequent lightweight and harder solve requests.
# OPENAI_FAST_MODEL=gpt-5.6-luna
# OPENAI_REASONING_MODEL=gpt-5.6-terra
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
CLIENT_TOKEN=replace-with-a-long-random-token
PORT=3000
SESSION_TTL_SECONDS=600
MAX_IMAGE_BYTES=10485760
MAX_AUDIO_BYTES=10485760
DAILY_QUERY_LIMIT=100
# Logs only operational metadata, never image/question/answer content.
REQUEST_METRICS=false
